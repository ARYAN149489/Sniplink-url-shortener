{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sniplink-backend-0xr5.onrender.com/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/:code([a-zA-Z0-9-_]{3,30})",
      "destination": "https://sniplink-backend-0xr5.onrender.com/:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
